# 专业师生业绩管理系统 - 环境变量示例
#
# 用法：把本文件复制为项目根目录下的 .env（或 backend/.env），按需修改后再启动。
# 说明：环境变量优先级最高，其次才是项目根目录 .env、backend/instance/secrets.json。
#       开发环境即使什么都不配置也能启动（密钥会自动生成并写入 secrets.json）；
#       APP_ENV=production 时必须显式提供 SECRET_KEY 与 JWT_SECRET_KEY。

# --------------------------------------------------------------------------- #
# 运行环境：development / testing / production
#   production 会强制要求密钥、绑定 0.0.0.0、启动前自动备份、使用 waitress 运行
# --------------------------------------------------------------------------- #
APP_ENV=development

# 监听地址与端口
HOST=127.0.0.1
PORT=5000

# --------------------------------------------------------------------------- #
# 安全密钥（生产环境必填，建议用 python -c "import secrets;print(secrets.token_hex(32))" 生成）
# --------------------------------------------------------------------------- #
SECRET_KEY=
JWT_SECRET_KEY=

# 令牌有效期
JWT_EXPIRE_HOURS=12
JWT_REFRESH_EXPIRE_DAYS=7

# 允许跨域访问的前端地址（逗号分隔；仅在需要跨机访问时修改）
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173

# --------------------------------------------------------------------------- #
# 数据存储位置（默认在 backend 目录下；改为绝对路径可迁移到数据盘）
# --------------------------------------------------------------------------- #
# DATABASE_URL=sqlite:///C:/data/achievement/app.db
# UPLOAD_FOLDER=C:/data/achievement/uploads
# BACKUP_FOLDER=C:/data/achievement/backups
# LOG_FOLDER=C:/data/achievement/logs

# 备份策略：保留份数与启动时是否自动备份
BACKUP_KEEP=10
BACKUP_ON_START=1

# 上传限制
MAX_CONTENT_LENGTH=20971520
MAX_ATTACHMENT_COUNT=20

# --------------------------------------------------------------------------- #
# 登录与口令策略
# --------------------------------------------------------------------------- #
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=300
LOGIN_WINDOW_SECONDS=900
MIN_PASSWORD_LENGTH=6
# 开启后新建账号首次登录必须修改密码
FORCE_PASSWORD_CHANGE=0
# 开启后拒绝常见弱口令（演示环境默认关闭，便于保留 123456 演示账号）
PASSWORD_STRENGTH_CHECK=0
# 开启后教师/学生新提交的成果默认进入「待审核」，由审核员审核后才计入统计
REQUIRE_REVIEW=0

# 学年起始月份（9 表示学年从当年 9 月算起）
ACADEMIC_YEAR_START_MONTH=9
ACADEMIC_YEAR_SPAN=12

# 访问日志
ACCESS_LOG_ENABLED=1

# 分页上限
PAGE_SIZE_MAX=100
